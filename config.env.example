# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=[REDACTED]

# Azure Cognitive Search Configuration
ELASTICSEARCH_URL=https://viggo-search.search.windows.net
ELASTICSEARCH_API_KEY=your_azure_search_api_key_here
ELASTICSEARCH_INDEX_PREFIX=viggo

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here

# Application Configuration
DATA_DIR=./data
LOG_LEVEL=INFO




