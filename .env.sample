# Copy this file to .env and fill in the values as needed

# --- API Keys ---
GROQ_API_KEY=your_groq_api_key_here

# --- Neo4j Configuration ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# --- Azure Cognitive Search Configuration ---
ELASTICSEARCH_URL=your_elasticsearch_url_here
ELASTICSEARCH_API_KEY=your_azure_search_api_key_here
ELASTICSEARCH_INDEX_PREFIX=viggo

# --- Redis Configuration ---
REDIS_HOST=your_redis_host_here
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL=true
REDIS_DB=0

# --- Cache Configuration ---
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# --- LLM Configuration ---
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# --- ML Configuration ---
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_PROJECT=viggo-lore-companion

# --- Application Configuration ---
DATA_DIR=./data
LOG_LEVEL=INFO